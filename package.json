{
  "name": "meshclip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:dump": "node scripts/snapshot.mjs dump",
    "db:restore": "node scripts/snapshot.mjs restore",
    "db:migrate": "node scripts/migrate.mjs",
    "db:shell": "docker compose exec postgres psql -U contentos -d contentos",
    "build": "next build",
    "build:check": "node scripts/build-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run api:typecheck",
    "api:dev": "npm run dev --prefix api",
    "api:build": "npm run build --prefix api",
    "api:typecheck": "npm run typecheck --prefix api",
    "api:smoke": "node scripts/api-smoke.mjs",
    "start": "next start",
    "worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./worker/register.mjs worker/index.ts",
    "worker:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./worker/register.mjs worker/setup.ts",
    "desktop": "cargo run --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "desktop:node": "node src-tauri/scripts/fetch-node.mjs",
    "desktop:installer": "npm run desktop:node && tauri build",
    "lint": "eslint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
