# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template a fresh clone copies from — DEPLOYING.md tells you to
# `cp` it, which needs it to be in the repo.
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build output from npm run build:check
.next-check

# Real generated runs — the only copy, not a cache.
.data/

# Local database credentials.
.env

# screenshots from scripts/browse.mjs
.shots

# the real production secrets
.env.production

# the NestJS API has its own install and build output
api/node_modules
api/dist

# the Tauri desktop app: Rust build output, and the ACL schemas tauri-build
# writes from tauri.conf.json on every compile. Cargo.lock is NOT here — this
# is an application, so the exact versions it was built against are part of it.
src-tauri/target
src-tauri/gen/schemas

# The Node the desktop app ships. ~90 MB, fetched and checksummed by
# src-tauri/scripts/fetch-node.mjs at build time — a runtime is not a thing to
# keep in a repository.
src-tauri/binaries
