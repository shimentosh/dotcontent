# Copy to .env for running dotcontent on your own machine. Never commit .env.
# For a server, start from .env.production.example instead.

# The worker's token. A run is written by a worker, and ./start.sh starts one
# beside the console when this is set. Mint it in Settings → Machines after
# you sign in; it is shown once.
DOTCONTENT_WORKER_TOKEN=

# Encrypts the API keys you save in Settings. Optional on your own machine,
# required on a server. Pick a long random string and keep it: a different
# value later makes every key already saved unreadable.
DOTCONTENT_SECRET=

# Only if the bundled Postgres (docker compose, port 5437) is not the one you
# want. This is the default:
# DATABASE_URL=postgres://contentos:contentos@localhost:5437/contentos

# Only if you would rather pay per token than use a signed-in CLI. Without it,
# sections are written by the `claude`, `codex` or `gemini` CLI on the worker.
# ANTHROPIC_API_KEY=
