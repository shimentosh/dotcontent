# Copy to .env.production on the server and fill in. Never commit the real one.

# The database password. Anything long and random.
POSTGRES_PASSWORD=

# The domain the console answers on, and the address Let's Encrypt writes to.
APP_HOST=content.yourcompany.com
ACME_EMAIL=you@yourcompany.com

# Encrypts the API keys stored in the settings table.
#
# MOVE THE EXISTING VALUE from your local .env. A different secret does not
# fail loudly — it makes every key already saved unreadable, which reads as
# "the key vanished".
CONTENTOS_SECRET=

# How the model is reached on a server.
#
# Your laptop runs the `claude` CLI and bills your subscription. A server has
# no CLI and no login, so it needs a key; the app falls back to the API path
# when the command is missing. Set the brain to the matching model in
# Settings → Generation after the first sign-in.
ANTHROPIC_API_KEY=
