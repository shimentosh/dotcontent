# Copy to .env.production on the server and fill in. Never commit the real one.

# The database password. Anything long and random.
POSTGRES_PASSWORD=

# The two hostnames: the web app, and the NestJS API the browser talks to.
# Both get their own certificate from Let's Encrypt at ACME_EMAIL.
APP_HOST=content.yourcompany.com
API_HOST=api.content.yourcompany.com
ACME_EMAIL=you@yourcompany.com

# The session cookie has to be readable on BOTH hosts: the API sets it, the
# web app's proxy checks for it. A shared parent domain does that. Leave
# COOKIE_SAMESITE at lax while the two hosts share a site; set it to none
# only if they do not (then Secure is forced, and the domain must be set).
COOKIE_DOMAIN=.content.yourcompany.com
COOKIE_SAMESITE=lax

# Encrypts the API keys stored in the settings table. REQUIRED in production —
# the API refuses to start without it.
#
# MOVE THE EXISTING VALUE from your local .env. Leaving this blank is caught at
# boot, but setting the WRONG value is not: a different secret does not fail
# loudly, it makes every key already saved unreadable, which reads on the page
# as "the key vanished".
DOTCONTENT_SECRET=

# How the model is reached on a server.
#
# Your laptop runs the `claude` CLI and bills your subscription. A server has
# no CLI and no login, so it needs a key; the app falls back to the API path
# when the command is missing. Set the brain to the matching model in
# Settings → Generation after the first sign-in.
ANTHROPIC_API_KEY=

# The first account, made at boot instead of by hand. Optional: while the
# users table is empty the console offers signup and the first account made
# becomes the owner, so this is for a deploy that wants no human step. Both
# lines or neither — one alone is skipped with a warning. Once an account
# exists these do nothing and can be removed.
DOTCONTENT_OWNER_EMAIL=
DOTCONTENT_OWNER_PASSWORD=
